		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^5.0.5",
		"postcss": "^8.5.32",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"typescript": "^5",
