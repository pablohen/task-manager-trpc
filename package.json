{
	"name": "task-manager-trpc",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check src *.ts *.mjs *.json",
		"format": "biome check --write src *.ts *.mjs *.json",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.0",
		"@mantine/core": "^9.7.4",
		"@mantine/hooks": "^9.7.4",
		"@mantine/modals": "^9.7.4",
		"@mantine/notifications": "^9.7.4",
		"@mantine/nprogress": "^9.7.4",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.105.0",
		"@trpc/client": "^11.22.1",
		"@trpc/server": "^11.22.1",
		"@trpc/tanstack-react-query": "^11.22.1",
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.91.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
